# ══════════════════════════════════════════════════════════════════════════
#  TellyBee — docker compose example
#
#  Copy to docker-compose.yml — it is gitignored on purpose, so your local
#  edits (networks, ports, resource limits, …) survive git pulls:
#
#      cp docker-compose.yml.example docker-compose.yml
#
#  Compose automatically substitutes ${TELEGRAM_API_ID} / ${TELEGRAM_API_HASH}
#  from the .env file next to this one.
# ══════════════════════════════════════════════════════════════════════════

services:
  tellybee:
    build:
      context: .
      dockerfile: Dockerfile
    image: tellybee:latest
    container_name: tellybee
    restart: unless-stopped
    # Start order only (bot polling retries on its own until botapi is up).
    depends_on:
      - botapi
    env_file: .env
    environment:
      # Inside the container files always live at these fixed paths.
      DOWNLOAD_DIR: /app/downloads
      DB_PATH: /app/data/tellybee.db
    volumes:
      - ./downloads:/app/downloads
      - ./data:/app/data
      # REQUIRED with the local Bot API server (API_BASE=http://botapi:8081):
      # in --local mode getFile returns absolute paths into the server's
      # storage and the server has NO HTTP file endpoint — tellybee reads
      # the bytes straight from this shared, read-only volume. The botapi
      # service's entrypoint runs the server as the same uid (1000) so the
      # owner-only file permissions line up. Remove this line only if you
      # disabled the botapi service.
      - botapi-data:/var/lib/telegram-bot-api:ro
    ports:
      # Health endpoint /healthz (and the webhook receiver if WEBHOOK_URL
      # is set). Bound to localhost by default — drop the "127.0.0.1:"
      # prefix only if you use WEBHOOK_URL so Telegram can reach it.
      - "127.0.0.1:8080:8080"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request, sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3).status == 200 else 1)"
      interval: 30s
      timeout: 5s
      start_period: 15s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # ── Local Bot API server (unlocks downloads up to 2 GB) ────────────────────
  # Requires in .env:
  #   TELEGRAM_API_ID / TELEGRAM_API_HASH   (from https://my.telegram.org)
  #   API_BASE=http://botapi:8081
  #   MAX_FILE_SIZE=2000MB
  #
  # To run WITHOUT it: comment this whole service out AND the depends_on
  # entry above, then remove API_BASE from .env and set MAX_FILE_SIZE=20MB.
  botapi:
    # arm64 + amd64 images (see hub.docker.com/r/aiogram/telegram-bot-api)
    image: aiogram/telegram-bot-api:10.3
    container_name: tellybee-botapi
    restart: unless-stopped
    # ── Why the custom entrypoint? ───────────────────────────────────────
    # The stock image starts the server as its own user (telegram-bot-api,
    # uid 101), and the server writes every received file with OWNER-ONLY
    # permissions (TDLib creates files 0600) under
    # /var/lib/telegram-bot-api/<bot-token>/… — while tellybee runs as
    # uid 1000, so reading those files off the shared volume fails with
    # "[Errno 13] Permission denied", and the local server has no HTTP
    # file endpoint to sidestep the filesystem.
    #
    # Fix: run the server as the SAME uid as tellybee. The wrapper below
    #   1. registers a uid/gid 1000 user inside this container (the
    #      server's --username flag resolves NAMES via getpwnam only),
    #   2. hands the volume over to uid 1000 (chown -R — existing files
    #      and the server's own binlogs keep working), and
    #   3. execs the server, which setuid()s to that user itself via its
    #      native --username/--groupname flags.
    # TELEGRAM_API_ID / TELEGRAM_API_HASH are read from the environment by
    # the server itself; --local unlocks 2 GB files and absolute paths.
    entrypoint:
      - /bin/sh
      - -c
      - |
        set -e
        addgroup -g 1000 tellybee 2>/dev/null || true
        adduser -D -H -u 1000 -G tellybee tellybee 2>/dev/null || true
        chown -R 1000:1000 "$$TELEGRAM_WORK_DIR" "$$TELEGRAM_TEMP_DIR"
        exec telegram-bot-api \
          --dir="$$TELEGRAM_WORK_DIR" \
          --temp-dir="$$TELEGRAM_TEMP_DIR" \
          --http-port=8081 \
          --username=tellybee \
          --groupname=tellybee \
          --local
    environment:
      TELEGRAM_API_ID: "${TELEGRAM_API_ID:?Set TELEGRAM_API_ID in .env — get it at https://my.telegram.org}"
      TELEGRAM_API_HASH: "${TELEGRAM_API_HASH:?Set TELEGRAM_API_HASH in .env — get it at https://my.telegram.org}"
    volumes:
      # Named volume on purpose (not a bind mount): docker initializes it
      # with the image's own ownership, and the entrypoint above hands it
      # to uid 1000 on every start. Telegram files up to 2 GB are cached
      # here before the bot copies them to ./downloads — keep an eye on
      # disk usage ("docker system df").
      - botapi-data:/var/lib/telegram-bot-api
    # Deliberately NOT published to the host: only the tellybee container
    # needs it over the internal compose network, and an exposed Bot API
    # server accepts any bot token it is given — a real security risk.
    # For local debugging only, uncomment:
    # ports:
    #   - "127.0.0.1:8081:8081"

volumes:
  botapi-data:
