# ══════════════════════════════════════════════════════════════════════════
#  TellyBee configuration — copy to .env and adjust
#  Every value has a sane default; only BOT_TOKEN is required.
# ══════════════════════════════════════════════════════════════════════════

# ── Required ────────────────────────────────────────────────────────────────
# Get a token from @BotFather on Telegram (https://t.me/BotFather)
BOT_TOKEN=

# ── Access control (two tiers) ─────────────────────────────────────────────
# Comma-separated Telegram user IDs (a JSON list like [111,222] also works).
# Admins: full control (/stats /users /allow /pause /config …)
# Allowed users: can send files (all user commands)
# Leave both empty for OPEN access (anyone can use the bot — beware!)
# Your own ID: message @userinfobot on Telegram.
# Example:
#   ADMIN_IDS=11111111,22222222
#   ALLOWED_USER_IDS=11111111,33333333
ADMIN_IDS=
ALLOWED_USER_IDS=

# ── Storage ─────────────────────────────────────────────────────────────────
# Root folder for downloads (inside the container: keep /app/downloads)
DOWNLOAD_DIR=downloads
# SQLite database location (keep /app/data inside the container)
DB_PATH=data/tellybee.db
# Folder layout template. Tokens: {user} {username} {user_id} {type} {date}
# {year} {month} {day} {chat_id} {chat_type}
FILE_TEMPLATE={user}/{type}/{date}

# ── Download engine ─────────────────────────────────────────────────────────
# Parallel downloads. 3 is a good default; raise on fast pipes.
DOWNLOAD_CONCURRENCY=3
# Maximum queued-but-not-started jobs (flood protection).
MAX_QUEUE_SIZE=100
# Retries per file with exponential backoff.
DOWNLOAD_RETRIES=3
# Per-file hard timeout (seconds).
DOWNLOAD_TIMEOUT=900
# How long getFile may block while the LOCAL Bot API server fetches a big
# file from Telegram (seconds). The server answers getFile only after the
# file is fully downloaded, so first-time downloads of large files take
# minutes on slow links — do NOT set this to 60 or less. Timed-out attempts
# still make progress (the server keeps downloading), and re-sending an
# already-fetched file is near-instant.
GETFILE_TIMEOUT=1800
# Stream chunk size. 256KB is a sweet spot for large files.
CHUNK_SIZE=256KB
# Reject files bigger than this (Bot API caps at 20MB; 2000MB with a local
# Bot API server — see README "Big files" section).
MAX_FILE_SIZE=20MB

# ── Progress UX ─────────────────────────────────────────────────────────────
# Files smaller than this get no live progress message (just the receipt).
PROGRESS_MIN_BYTES=2MB
# Seconds between progress message edits (Telegram rate-limit friendly).
PROGRESS_EDIT_INTERVAL=2.0

# ── Media type filters ──────────────────────────────────────────────────────
# Types: photo, video, document, audio, voice, video_note, sticker, animation
# Comma-separated (or a JSON list like ["photo","video"] — empty = default).
# ALLOWED_TYPES: if set, ONLY these are accepted. BLOCKED_TYPES: never accept.
# Example:
#   ALLOWED_TYPES=photo,video,document
#   BLOCKED_TYPES=sticker
ALLOWED_TYPES=
BLOCKED_TYPES=

# ── Serving mode ────────────────────────────────────────────────────────────
# Default: long polling (works behind NAT/firewalls, zero config).
# Setting WEBHOOK_URL switches to webhook mode automatically.
POLLING_MODE=true
# WEBHOOK_URL=https://your.domain.example/tellybee/webhook
WEBHOOK_URL=
WEBHOOK_PATH=/tellybee/webhook
# Optional shared secret Telegram sends in X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080

# ── Custom Bot API server (optional, for 2GB files) ────────────────────────
# Point at a self-hosted telegram-bot-api instance, e.g. http://botapi:8081
# (docker-compose.yml.example runs one as the "botapi" service).
# When set, also raise MAX_FILE_SIZE up to 2000MB, and keep BOTH: the
# botapi-data:/var/lib/telegram-bot-api:ro volume mount on the tellybee
# service (in local mode files are read straight from that shared volume)
# AND the botapi service's entrypoint from the example (it runs the server
# as the same uid as tellybee, without which every download fails with
# "[Errno 13] Permission denied").
API_BASE=
# Credentials for the local Bot API server — docker compose reads these
# directly from this file. Get them at https://my.telegram.org
# ("API development tools"). Only needed when the botapi service is enabled.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Behavior & logging ──────────────────────────────────────────────────────
# Messages per user per window before throttling kicks in.
THROTTLE_RATE=20
THROTTLE_WINDOW=60
LOG_LEVEL=INFO
# text | json (json is nice for log collectors)
LOG_FORMAT=text
